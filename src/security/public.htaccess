# BEGIN HORIZONS HARDENING
<FilesMatch "(?i)(?:^\.env(?:\..*)?$|^\.ht.*$|^\.user\.ini$|^php\.ini$|^error_log$|^\.cpanel\.yml$|^config(?:-path)?\.php(?:\..*)?$|^(?:bootstrap|Core|features)\.php(?:\..*)?$|^owner-vault\.(?:json|php)(?:\..*)?$|^key\.bin$|^composer\.(?:json|lock)$|^package(?:-lock)?\.json$|\.(?:sqlite(?:3)?(?:-wal|-shm)?|db(?:-wal|-shm)?|sql(?:\.(?:gz|bz2|xz|zip))?|bak|backup|bkp|old|orig|save|swp|swo|pem|key|ini|log)$|~$)">
Require all denied
</FilesMatch>
# END HORIZONS HARDENING

# BEGIN HORIZONS HARDENING
# Apache 2.4 authorization; compatible with PHP-FPM, without handler changes.
<FilesMatch "(?i)^(?:[.]env(?:[.].*)?|[.]ht.*|[.]user[.]ini|php[.]ini|error_log|[.]cpanel[.]yml|config(?:-path)?[.]php(?:[.].*)?|(?:bootstrap|Core|features|owner-vault)[.]php(?:[.].*)?|key[.]bin|composer[.](?:json|lock)|package(?:-lock)?[.]json|.*[.](?:sqlite(?:3)?(?:-wal|-shm)?|db(?:-wal|-shm)?|sql(?:[.](?:gz|bz2|xz|zip))?|bak|backup|bkp|old|orig|save|swp|swo|pem|key|ini|log)|.*~)$">
  Require all denied
</FilesMatch>
# Conditional authorization also applies when a child directory has rewrites.
<If "%{REQUEST_URI} =~ m#(?:^|/)[.](?:git|svn|hg)(?:/|$)#i">
  Require all denied
</If>
# These namespaces contain static releases, never public PHP endpoints.
# Deny alternate/compound extensions and PATH_INFO before any PHP handler.
<If "%{REQUEST_URI} =~ m#^/(?:assets|downloads|updates|try|learn/content)/.*[.](?:php[0-9]*|phtml|pht|phar|phps)(?:[./].*)?$#i">
  Require all denied
</If>
# END HORIZONS HARDENING
